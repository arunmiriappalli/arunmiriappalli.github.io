---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, canonicalUrl, mediumUrl } = post.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} type="article">
  <article class="prose">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-header__meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {
          tags.length > 0 && (
            <span class="post-header__tags">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          )
        }
      </div>
      {
        mediumUrl && (
          <p class="post-header__medium">
            Also published on <a href={mediumUrl}>Medium</a>.
          </p>
        )
      }
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-3);
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-header__tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    background: var(--color-bg-subtle);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .post-header__medium {
    margin-top: var(--space-1);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
